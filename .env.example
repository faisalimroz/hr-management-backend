# Application Configuration
APP_NAME="HR Management Platform API"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security / JWT
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY="supersecretdevelopmentkeythatmustbechangedinproductionenvironment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to SQLite for easy local development, or configure PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hrms_db"
DATABASE_URL="sqlite:///./hrms.db"

# Initial Admin Seed Credentials
INITIAL_ADMIN_EMAIL="admin@hrms.local"
INITIAL_ADMIN_PASSWORD="AdminPassword123!"
INITIAL_ADMIN_FIRST_NAME="System"
INITIAL_ADMIN_LAST_NAME="Administrator"

# CORS Configuration (comma separated origins or "*")
CORS_ORIGINS="*"
